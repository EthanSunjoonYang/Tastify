DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/spotify_comparator

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify requires HTTPS or the literal loopback IP 127.0.0.1 -- "localhost" is rejected
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:5173
